import org.junit.runner.RunWith;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.ContextConfiguration;
import org.springframework.test.context.junit4.SpringJUnit4ClassRunner;

import static org.junit.Assert.assertNotNull;

@RunWith(SpringJUnit4ClassRunner.class)
@ContextConfiguration(classes = com.sab.fcm.carm.config.CarmFcmConfiguration.class)
@Ignore("Enable explicitly for a real non-PROD Facility Capital Markers environment")
public class FacilityCapitalMarkersLiveIntegrationTest {

    @Autowired
    private CarmFcmMasterService masterService;

    @Test
    public void shouldLoadReferenceDataFromFacilityCapitalMarkers() {
        JsonNode result = masterService.getReferenceData();
        assertNotNull(result);
        assertNotNull(result.fields());
    }
}
